{
	"name": "pi-monocoque",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"pi": {
		"extensions": [
			"./packages/rpiv-pi/extensions/rpiv-core/index.ts",
			"./packages/rpiv-args/index.ts",
			"./packages/rpiv-ask-user-question/index.ts",
			"./packages/rpiv-todo/index.ts",
			"./packages/rpiv-advisor/index.ts",
			"./packages/rpiv-i18n/index.ts",
			"./packages/rpiv-web-tools/index.ts",
			"./packages/rpiv-workflow/extension.ts"
		],
		"skills": [
			"./packages/rpiv-pi/skills"
		]
	},
	"scripts": {
		"check": "npm run check:host-provided-deps && biome check --write --error-on-warnings . && tsc --noEmit -p tsconfig.base.json",
		"check:files": "biome check --write --error-on-warnings",
		"check:decision-codes": "node scripts/check-no-decision-codes.mjs",
		"check:file-sizes": "node scripts/check-file-sizes.mjs",
		"check:host-provided-deps": "node scripts/check-host-provided-deps.mjs",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"versions:sync": "node scripts/sync-versions.js",
		"prepare": "husky || true"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@earendil-works/pi-ai": "1.2.0",
		"@earendil-works/pi-coding-agent": "1.2.0",
		"@earendil-works/pi-tui": "1.2.0",
		"@tintinweb/pi-subagents": "0.17.0",
		"typebox": "1.3.6",
		"@types/node": "22.20.1",
		"@vitest/coverage-v8": "4.1.10",
		"husky": "9.1.7",
		"shx": "0.4.0",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=11.0.0"
	},
	"overrides": {
		"@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@1.2.0",
		"@mariozechner/pi-ai": "npm:@earendil-works/pi-ai@1.2.0",
		"@mariozechner/pi-tui": "npm:@earendil-works/pi-tui@1.2.0"
	}
}
