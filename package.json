{
	"name": "pi-monocoque",
	"version": "3.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"pi": {
		"extensions": [
			"./packages/rpiv-pi/extensions/rpiv-core/index.ts",
			"./packages/rpiv-args/index.ts",
			"./packages/rpiv-ask-user-question/index.ts",
			"./packages/rpiv-todo/index.ts",
			"./packages/rpiv-advisor/index.ts",
			"./packages/rpiv-i18n/index.ts",
			"./packages/rpiv-web-tools/index.ts"
		],
		"skills": [
			"./packages/rpiv-pi/skills",
			"./skills/matt-pocock",
			"./skills/skill-master",
			"./skills/repo-5s"
		]
	},
	"scripts": {
		"check": "npm run check:host-provided-deps && npm run check:unused-deps && biome check --write --error-on-warnings packages scripts test vitest.config.ts && tsc --noEmit -p tsconfig.base.json",
		"check:files": "biome check --write --error-on-warnings",
		"check:decision-codes": "node scripts/check-no-decision-codes.mjs",
		"check:file-sizes": "node scripts/check-file-sizes.mjs",
		"check:host-provided-deps": "node scripts/check-host-provided-deps.mjs",
		"check:unused-deps": "node scripts/check-unused-deps.mjs",
		"check:skill-names": "node scripts/check-skill-name-collisions.mjs",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"versions:sync": "node scripts/sync-versions.js",
		"versions:check": "node scripts/sync-versions.js --check",
		"prepare": "husky || true"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@earendil-works/pi-ai": "1.6.1",
		"@earendil-works/pi-coding-agent": "1.6.1",
		"@earendil-works/pi-tui": "1.6.1",
		"@tintinweb/pi-subagents": "0.26.3",
		"typebox": "1.3.27",
		"@types/node": "22.20.1",
		"@vitest/coverage-v8": "5.1.2",
		"husky": "9.1.7",
		"shx": "0.4.0",
		"typescript": "7.0.2",
		"vitest": "5.1.2"
	},
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=11.0.0"
	},
	"overrides": {
		"@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@1.6.1",
		"@mariozechner/pi-ai": "npm:@earendil-works/pi-ai@1.6.1",
		"@mariozechner/pi-tui": "npm:@earendil-works/pi-tui@1.6.1"
	}
}
