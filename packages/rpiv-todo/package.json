{
	"name": "@hs1n/rpiv-todo",
	"version": "2.11.0",
	"description": "Pi extension. A todo list for the model, rendered as a live overlay that survives /reload and conversation compaction.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"rpiv",
		"todo"
	],
	"type": "module",
	"license": "MIT",
	"author": "hs1n",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hs1n/pi-monocoque.git",
		"directory": "packages/rpiv-todo"
	},
	"homepage": "https://github.com/hs1n/pi-monocoque/tree/main/packages/rpiv-todo#readme",
	"bugs": {
		"url": "https://github.com/hs1n/pi-monocoque/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run"
	},
	"files": [
		"config.ts",
		"index.ts",
		"locales/",
		"todo.ts",
		"todo-overlay.ts",
		"LICENSE",
		"docs/",
		"!docs/*.png",
		"!docs/*.jpg",
		"!docs/*.svg",
		"README.md",
		"state/invariants.ts",
		"state/i18n-bridge.ts",
		"state/replay.ts",
		"state/selectors.ts",
		"state/state-reducer.ts",
		"state/state.ts",
		"state/store.ts",
		"state/task-graph.ts",
		"tool/response-envelope.ts",
		"tool/sanitize.ts",
		"tool/types.ts",
		"view/format.ts"
	],
	"pi": {
		"image": "https://raw.githubusercontent.com/hs1n/pi-monocoque/main/packages/rpiv-todo/docs/cover.png",
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@hs1n/rpiv-i18n": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"peerDependenciesMeta": {
		"@hs1n/rpiv-i18n": {
			"optional": true
		}
	},
	"dependencies": {
		"@hs1n/rpiv-config": "^2.11.0",
		"typebox": "^1.1.24"
	},
	"contributors": [
		"juicesharp <https://github.com/juicesharp>"
	]
