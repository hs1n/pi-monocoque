{
	"name": "@hs1n/rpiv-i18n",
	"version": "2.13.8",
	"description": "Pi extension. The localization foundation for rpiv-* skills: locale detection, the /languages command, the --locale flag, and a cross-package locale registry.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"rpiv",
		"i18n",
		"localization"
	],
	"type": "module",
	"license": "MIT",
	"author": "hs1n",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hs1n/pi-monocoque.git",
		"directory": "packages/rpiv-i18n"
	},
	"homepage": "https://github.com/hs1n/pi-monocoque/tree/main/packages/rpiv-i18n#readme",
	"bugs": {
		"url": "https://github.com/hs1n/pi-monocoque/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run"
	},
	"files": [
		"index.ts",
		"i18n.ts",
		"i18n-ui.ts",
		"loader.ts",
		"docs/",
		"!docs/*.png",
		"!docs/*.jpg",
		"!docs/*.svg",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": "./i18n.ts",
		"./loader": "./loader.ts"
	},
	"pi": {
		"image": "https://raw.githubusercontent.com/hs1n/pi-monocoque/main/packages/rpiv-i18n/docs/cover.png",
		"extensions": [
			"./index.ts"
		]
	},
	"dependencies": {
		"@hs1n/rpiv-config": "^2.13.8"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"contributors": [
		"juicesharp <https://github.com/juicesharp>"
	]
}
