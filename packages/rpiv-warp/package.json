{
	"name": "@hs1n/rpiv-warp",
	"version": "2.11.0",
	"private": false,
	"description": "Pi extension. Native Warp terminal notifications, dispatched via OSC 777 on Pi lifecycle events.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"rpiv",
		"warp",
		"terminal",
		"notifications",
		"osc-777"
	],
	"type": "module",
	"license": "MIT",
	"author": "hs1n",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hs1n/pi-monocoque.git",
		"directory": "packages/rpiv-warp"
	},
	"homepage": "https://github.com/hs1n/pi-monocoque/tree/main/packages/rpiv-warp#readme",
	"bugs": {
		"url": "https://github.com/hs1n/pi-monocoque/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./index.ts"
	},
	"scripts": {
		"test": "vitest run"
	},
	"files": [
		"index.ts",
		"protocol.ts",
		"warp-notify.ts",
		"title-spinner.ts",
		"payload.ts",
		"config.ts",
		"docs/",
		"!docs/*.png",
		"!docs/*.jpg",
		"!docs/*.svg",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"pi": {
		"image": "https://raw.githubusercontent.com/hs1n/pi-monocoque/main/packages/rpiv-warp/docs/cover.png",
		"extensions": [
			"./index.ts"
		],
		"ambientObserver": true
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"dependencies": {
		"@hs1n/rpiv-config": "^2.11.0"
	},
	"contributors": [
		"juicesharp <https://github.com/juicesharp>"
	]
}
