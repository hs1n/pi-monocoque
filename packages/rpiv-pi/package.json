{
	"name": "@hs1n/rpiv-pi",
	"version": "2.13.8",
	"description": "A skill-based development workflow for Pi Agent. 30 contract-carrying skills (discover → research → design → plan → implement → validate → code-review → commit, and more), the 15 named subagents they dispatch, and four built-in /wf workflows that chain them end to end in detached parallel runs.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"rpiv",
		"skills",
		"workflow"
	],
	"license": "MIT",
	"author": "hs1n",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hs1n/pi-monocoque.git",
		"directory": "packages/rpiv-pi"
	},
	"homepage": "https://github.com/hs1n/pi-monocoque/tree/main/packages/rpiv-pi#readme",
	"bugs": {
		"url": "https://github.com/hs1n/pi-monocoque/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run"
	},
	"files": [
		"extensions/",
		"skills/",
		"agents/",
		"scripts/",
		"docs/",
		"!docs/*.png",
		"!docs/*.jpg",
		"!docs/*.svg",
		"README.md",
		"LICENSE",
		"!**/*.test.ts",
		"!extensions/rpiv-core/workflow-test-harness.ts",
		"!extensions/rpiv-core/built-ins/__fixtures__/"
	],
	"pi": {
		"image": "https://raw.githubusercontent.com/hs1n/pi-monocoque/main/packages/rpiv-pi/docs/cover.png",
		"extensions": [
			"./extensions"
		],
		"skills": [
			"./skills"
		]
	},
	"dependencies": {
		"@hs1n/rpiv-config": "^2.13.8"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@tintinweb/pi-subagents": "*",
		"@hs1n/rpiv-ask-user-question": "*",
		"@hs1n/rpiv-todo": "*",
		"@hs1n/rpiv-advisor": "*",
		"@hs1n/rpiv-i18n": "*",
		"@hs1n/rpiv-web-tools": "*",
		"@hs1n/rpiv-args": "*",
		"@hs1n/rpiv-workflow": "*",
		"yaml": "*",
		"jiti": "*",
		"@standard-schema/spec": "*",
		"typebox": "*"
	},
	"contributors": [
		"juicesharp <https://github.com/juicesharp>"
	]
}
