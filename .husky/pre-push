#!/bin/sh

# Full test + coverage gate before a push.
#
# Retry policy: the v8 coverage provider writes one temp file per test file into
# `coverage/.tmp/` and merges them at the end of the run. On a loaded machine a recycled
# worker can leave one of those writes missing, and the merge then dies with
# `ENOENT ... coverage/.tmp/coverage-<n>.json` — an infra failure with no failing test
# behind it (observed once, on a machine that was busy; the same commit pushed clean four
# times around it). That failure mode is indistinguishable from a real one at the exit
# code, so: clear the temp dir, run, and on failure run ONCE more. The second run is the
# verdict — a genuine test or threshold failure fails both times and still aborts the push.
run_coverage() {
  rm -rf coverage/.tmp
  npm run coverage
}

echo "Running test suite with coverage before push..."
if run_coverage; then
  echo "Tests + coverage passed."
  exit 0
fi

echo ""
echo "⚠️  Coverage run failed — retrying once with a cleared coverage/.tmp"
echo "    (a missing v8 temp file on a loaded machine is a known false failure)"
echo ""

if run_coverage; then
  echo "Tests + coverage passed on the retry — the first run was the known temp-file race."
  exit 0
fi

echo "Tests or coverage thresholds failed twice. Push aborted."
exit 1
